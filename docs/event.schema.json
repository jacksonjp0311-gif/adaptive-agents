{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Agents event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event_id",
    "instance_id",
    "assignment_id",
    "project_id",
    "type",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "number"
    },
    "payload": {
      "type": "object"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Extensible event kind. See INTEGRATION.md for version 1 payload semantics."
    }
  }
}
